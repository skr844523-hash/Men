# APP_URL: The public URL where this app is hosted.
APP_URL="https://your-domain.example"

# Set this to a long random secret (at least 32 characters) in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Designated administrator email. Set to the email you will use for your admin account.
ADMIN_EMAIL=admin@example.com

# Optional passcode for Admin Dashboard access. Keep empty if not used.
ADMIN_PASSCODE=
